<%- include('../partials/head') %>
</head>

<body class="min-h-screen bg-gray-100 from-slate-50 via-white to-rose-50 font-sans">

  <%- include('../partials/nav') %>

  <main class="flex min-h-[85vh] items-center justify-center px-6">
    <div class="w-full max-w-md rounded-3xl bg-white p-8 shadow-2xl">

      <div class="mb-8 text-center">

        <h1 class="text-4xl font-extrabold text-gray-800">
          Welcome Back 👋
        </h1>

        <p class="mt-3 text-gray-500">
          Login to continue exploring amazing stays
        </p>

      </div>

      <% if(typeof errors !== 'undefined' && errors && errors.length > 0){ %>
      <div class="mb-6 rounded-lg border border-red-200 bg-red-50 p-4">
        
        <ul class="space-y-2">
          <% errors.forEach(err => { %>
          <li class="text-sm text-red-700"><span class="font-semibold">•</span> Error: <%= err %></li>
          <% }) %>
        </ul>
      </div>
      <% } %>

      <form action="/login" method="POST" class="space-y-5">
        <div>

          <label for="email" class="mb-2 block font-medium text-gray-700">
            Email Address
          </label>

          <input id="email" type="email" name="email" 
          value="<%= oldvalues.email ? oldvalues.email : '' %>" placeholder="Enter your email" required class="w-full rounded-xl border border-gray-300 px-4 py-3 outline-none transition focus:border-rose-500">
        </div>

        <div>
          <label class="mb-2 block font-medium text-gray-700">
            Password
          </label>

          <input type="password" name="password" placeholder="Enter your password" required class="w-full rounded-xl border border-gray-300 px-4 py-3 outline-none transition focus:border-rose-500">
        </div>

        <button type="submit" class="w-full rounded-xl bg-gradient-to-r from-rose-500 via-pink-500 to-orange-400 py-3 font-bold text-white shadow-lg transition duration-300 hover:scale-105">
          Login
        </button>
      </form>

      <div class="my-6 flex items-center">
        <div class="h-px flex-1 bg-gray-300"></div>
        <span class="px-4 text-sm text-gray-500">
          OR
        </span>
        <div class="h-px flex-1 bg-gray-300"></div>
      </div>

      <button class="flex w-full items-center justify-center gap-3 rounded-xl border border-gray-300 py-3 font-semibold text-gray-700 transition hover:bg-gray-50">
        <span>🔍</span>
        Continue with Google
      </button>

      <p class="mt-8 text-center text-gray-500">
        Don't have an account?
        <a href="/signup" class="font-semibold text-rose-500 hover:text-rose-700">
          Sign Up
        </a>

      </p>

    </div>
  </main>
</body>

</html>