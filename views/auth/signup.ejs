<%- include('../partials/head') %>
</head>

<body class="min-h-screen bg-slate-50 font-sans text-slate-900">
  <%- include('../partials/nav') %>

  <main class="relative isolate overflow-hidden">
    <div class="absolute inset-0 -z-10 bg-gradient-to-br from-rose-50 via-white to-orange-50"></div>
    <div class="absolute -left-24 top-20 -z-10 h-72 w-72 rounded-full bg-rose-200/40 blur-3xl"></div>
    <div class="absolute -right-24 bottom-10 -z-10 h-80 w-80 rounded-full bg-orange-200/40 blur-3xl"></div>

    <section class="mx-auto flex min-h-[calc(100vh-76px)] max-w-6xl justify-center items-center px-4 py-10 sm:px-6 lg:px-8">
      <div class="px-16 py-12 overflow-hidden rounded-3xl border border-white/70 bg-white shadow-2xl shadow-rose-100/60 lg:grid-cols-5">

          <div class="mx-auto max-w-xl">
            <div class="mb-8">
              <p class="mb-2 text-sm font-bold uppercase tracking-[0.2em] text-rose-500">
                Get started
              </p>
              <h2 class="text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">
                Create your account
              </h2>
              <p class="mt-3 text-slate-500">
                Enter your details below to start exploring.
              </p>
            </div>

            <% if(typeof errors !== 'undefined' && errors && errors.length > 0){ %>
            <div class="mb-6 rounded-lg border border-red-200 bg-red-50 p-4">
              <h3 class="mb-2 text-sm font-semibold text-red-700">
                Please fix the following errors:
              </h3>
                <ul class="space-y-2">
                 <% errors.forEach(err => { %> 
                    <li class="text-sm text-red-700"><span class="font-semibold">•</span> <%= err %></li>
                  <% }) %>
                </ul>
            </div>
            <% } %>

            <form action="/signup" method="POST" class="space-y-5">
              <div class="grid gap-5 sm:grid-cols-2">
                <div>
                  <label for="firstname" class="mb-2 block text-sm font-semibold text-slate-700">
                    First name
                  </label>
                  <input
                    id="firstname"
                    type="text"
                    name="firstname"
                    value="<%= oldvalues.firstname ? oldvalues.firstname : '' %>"
                    placeholder="Dipanshu"
                    autocomplete="given-name"
                    required
                    class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-rose-400 focus:bg-white focus:ring-4 focus:ring-rose-100"
                  >
                </div>

                <div>
                  <label for="lastname" class="mb-2 block text-sm font-semibold text-slate-700">
                    Last name
                  </label>
                  <input
                    id="lastname"
                    type="text"
                    name="lastname"
                    value="<%= oldvalues.lastname ? oldvalues.lastname : '' %>"
                    placeholder="yadav"
                    autocomplete="family-name"
                    required
                    class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-rose-400 focus:bg-white focus:ring-4 focus:ring-rose-100"
                  >
                </div>
              </div>

              <div>
                <label for="email" class="mb-2 block text-sm font-semibold text-slate-700">
                  Email address
                </label>
                <input
                  id="email"
                  type="email"
                  name="email"
                  value="<%= oldvalues.email ? oldvalues.email : '' %>"
                  placeholder="yadav@example.com"
                  autocomplete="email"
                  required
                  class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-rose-400 focus:bg-white focus:ring-4 focus:ring-rose-100"
                >
              </div>

              <div class="grid gap-5 sm:grid-cols-2">
                <div>
                  <label for="password" class="mb-2 block text-sm font-semibold text-slate-700">
                    Password
                  </label>
                  <input
                    id="password"
                    type="password"
                    name="password"
                    placeholder="At least 8 characters"
                    autocomplete="new-password"
                    minlength="8"
                    required
                    class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-rose-400 focus:bg-white focus:ring-4 focus:ring-rose-100"
                  >
                </div>

                <div>
                  <label for="confirmpassword" class="mb-2 block text-sm font-semibold text-slate-700">
                    Confirm password
                  </label>
                  <input
                    id="confirmpassword"
                    type="password"
                    name="confirmpassword"
                    placeholder="Repeat password"
                    autocomplete="new-password"
                    minlength="8"
                    required
                    class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-rose-400 focus:bg-white focus:ring-4 focus:ring-rose-100"
                  >
                </div>
              </div>

              <div>
                <label for="usertype" class="mb-2 block text-sm font-semibold text-slate-700">
                  I want to join as
                </label>
                <select
                  name="usertype"
                  id="usertype"
                  
                  class="w-full cursor-pointer rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-slate-700 outline-none transition focus:border-rose-400 focus:bg-white focus:ring-4 focus:ring-rose-100"
                >
                  <option value="guest" <%= (oldvalues.usertype === 'guest') ? 'selected' : '' %>>Guest - I want to book stays</option>
                  <option value="host" <%= (oldvalues.usertype === 'host') ? 'selected' : '' %>>Host - I want to list my property</option>
                </select>
              </div>

              <label class="flex cursor-pointer items-start gap-3 rounded-xl border border-slate-100 bg-slate-50/70 p-4">
                <input
                  type="checkbox"
                  name="tnc"
                  required
                  class="mt-0.5 h-5 w-5 shrink-0 cursor-pointer rounded border-slate-300 accent-rose-500"
                >
                <span class="text-sm leading-5 text-slate-600">
                  I agree to the
                  <a href="#" class="font-semibold text-rose-500 transition hover:text-rose-600">Terms of Service</a>
                  and
                  <a href="#" class="font-semibold text-rose-500 transition hover:text-rose-600">Privacy Policy</a>.
                </span>
              </label>
 
              <button
                type="submit"
                class="group flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-rose-500 via-pink-500 to-orange-400 px-5 py-3.5 text-base font-bold text-white shadow-lg shadow-rose-200 transition duration-300 hover:-translate-y-0.5 hover:shadow-xl hover:shadow-rose-200 focus:outline-none focus:ring-4 focus:ring-rose-200"
              >
                Create account
                <svg class="h-5 w-5 transition-transform group-hover:translate-x-1" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                  <path d="M4 10H16M11.5 5.5L16 10L11.5 14.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
            </form>

            <p class="mt-7 text-center text-sm text-slate-500">
              Already have an account?
              <a href="/login" class="font-bold text-rose-500 transition hover:text-rose-600">
                Log in
              </a>
            </p>
          </div>
        
      </div>
    </section>
  </main>
</body>
</html>
