<%- include('../partials/head') %>
</head>

<body class="min-h-screen bg-gradient-to-br from-slate-50 via-white to-rose-50 font-sans">

  <!-- Navbar -->
  <%- include('../partials/nav') %>

  <!-- Hero Section -->
  <section class="relative flex flex-col items-center justify-center px-6 py-10 text-center">

    <h2 class="mb-2 bg-gradient-to-r from-rose-500 via-pink-500 to-orange-400 bg-clip-text text-6xl font-extrabold text-transparent">
      Find your next stay
    </h2>

    <p class="mb-10 max-w-3xl text-xl leading-relaxed text-gray-600">
      Discover unique homes, apartments, and vacation rentals around the world.
    </p>

    <a
      href="/store/index"
      class="rounded-full bg-gradient-to-r from-rose-500 via-pink-500 to-orange-400 px-10 py-4 text-lg font-bold text-white shadow-[0_10px_40px_rgba(244,63,94,0.4)] transition-all duration-300 hover:scale-110 hover:shadow-[0_15px_50px_rgba(244,63,94,0.5)]"
    >
      Explore Homes
    </a>

  </section>

  <!-- Properties Section -->
  <section class="mx-auto max-w-7xl px-6 py-10">

    <div class="grid gap-12 sm:grid-cols-2 xl:grid-cols-3">

      <% registeredHome.forEach((home)=>{ %>

        <div
          class="group overflow-hidden rounded-[2rem] border border-gray-100 bg-white shadow-xl transition-transform duration-300 hover:-translate-y-4">

          <!-- Image -->
          <div class="relative overflow-hidden" >

            <img
              src="<%= home.photoUrl %>"
              alt="Home"
              loading="lazy"
              decoding="async"
              class="h-72 w-full object-cover transition duration-700 group-hover:scale-110">

            <!-- Rating Badge -->
            <div
              class="absolute right-4 top-4 rounded-full bg-white/90 px-4 py-2 text-sm font-bold shadow-lg">
              ⭐ <%= home.rating %>
            </div>

            <!-- Price Badge -->
            <div
              class="absolute bottom-4 left-4 rounded-2xl bg-black/70 px-5 py-3 text-xl font-bold text-white">
              ₹<%= home.price %>
              <span class="text-sm font-normal text-gray-200">/night</span>
            </div>

          </div>

          <!-- Content -->
          <div class="space-y-4 p-7">

            <div class="flex items-center justify-between">

              <h3 class="text-3xl font-extrabold tracking-tight text-gray-900">
                <%= home.housename %>
              </h3>

              <span
                class="rounded-full bg-emerald-500/10 px-4 py-1 text-xs font-bold uppercase tracking-wider text-emerald-600">
                Available
              </span>

            </div>

            <div class="flex items-center gap-2 text-base font-medium text-gray-500">
              <span>📍</span>
              <span><%= home.location %></span>
            </div>

            <p class="leading-7 text-gray-600">
              <%= home.description %>
            </p>
            
            <div class="flex gap-3 ">

              <a
                href="/home/<%= home._id %>"
                class="mt-3 flex w-full items-center justify-center rounded-xl bg-rose-500 px-6 py-3 font-semibold text-white hover:bg-rose-600"
              >
                Details
              </a>

              <%- include("../partials/submitFavourite", {home}) %>

            </div>

            <div class="pt-2">
              <button
                class="w-full rounded-2xl bg-gradient-to-r from-amber-400 via-orange-400 to-rose-500 py-3 font-bold text-white shadow-lg transition-all duration-300 hover:scale-105">
                Book Now
              </button>
            </div>

          </div>

        </div>

      <% }) %>

    </div>

  </section>

</body>

</html>
