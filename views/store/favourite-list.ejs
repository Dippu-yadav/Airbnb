<%- include('../partials/head')  %>
</head>
<body class="min-h-screen bg-gray-100 font-sans">

  <!-- Navbar -->
  <%- include('../partials/nav') %>

  

  <section class="mx-auto max-w-7xl px-6 py-16">

    <div class="mb-12 text-center">
      <h2 class="text-5xl font-extrabold tracking-tight text-gray-900">
        Your Favourites 💓
      </h2>
      <p class="mt-4 text-lg text-gray-500">
        Favourite homes 🏠
      </p>
    </div>

    <div class="grid gap-10 sm:grid-cols-2 xl:grid-cols-3">
      
      <% favouritesWithDetails.forEach((home)=>{ %>
        
        <div class="group overflow-hidden rounded-3xl bg-white shadow-lg transition-all duration-500 hover:-translate-y-3 hover:shadow-2xl">

          <!-- Image Section -->
          <div class="relative overflow-hidden">

            <img
              src=" <%= home.Url %> "
              alt="Home"
              class="h-72 w-full object-cover transition duration-700 group-hover:scale-110"
            >

            <!-- Rating Badge -->
            <div class="absolute right-4 top-4 rounded-full bg-white/90 px-4 py-2 text-sm font-bold shadow backdrop-blur-md">
              ⭐ <%= home.rating %>
            </div>

            <!-- Price Badge -->
            <div class="absolute bottom-4 left-4 rounded-2xl bg-black/70 px-4 py-2 text-lg font-bold text-white backdrop-blur-md">
              ₹<%= home.price %>
              <span class="text-sm font-normal text-gray-200">/night</span>
            </div>

          </div>

          <!-- Content -->
          <div class="p-6">

            <div class="mb-2 flex items-center justify-between">

              <h3 class="text-2xl font-bold text-gray-900">
                <%= home.housename %>
              </h3>

              <span class="rounded-full bg-emerald-100 px-3 py-1 text-xs font-semibold text-emerald-700">
                Available
              </span>

            </div>

            <div class="mb-4 flex items-center gap-2 text-gray-500">
              <span>📍</span>
              <span><%= home.location %></span>
            </div>

            <p class="mb-6 leading-relaxed text-gray-600">
              Experience comfort, luxury, and unforgettable memories in this carefully selected property.
            </p>

            <div class="flex gap-3">
              <a
                href="/home/<%= home._id %>"
                class="mt-3 flex w-full items-center justify-center rounded-xl bg-rose-500 px-6 py-3 font-semibold text-white hover:bg-rose-600"
              >
                View Details
              </a>
            </div>

            <div class="mt-3">
              <form action="/favourites/delete/<%= home._id %>" method="POST">
                <input type="hidden" name="homeid" value="<%= home._id %>">
                <button type="submit"
                class="flex-1 w-full rounded-xl bg-linear-to-r from-red-500 to-red-600 py-3 font-semibold text-black transition hover:scale-105">
                  Remove
                </button>
              </form>
            </div>
            
          </div>
        </div>

      <% }) %>

    </div>

  </section>
</body>
</html>